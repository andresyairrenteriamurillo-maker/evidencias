rules_version = '2';
// Reglas de seguridad: cada docente solo ve y edita lo suyo; la rectora ve todo.
// Rectoría: docentes.ierss@hotmail.com y andres.yair.renteria.murillo@gmail.com (en minúsculas).
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function correo() {
      return request.auth.token.email.lower();
    }
    function esRectora() {
      return conSesion() && correo() in ['docentes.ierss@hotmail.com', 'andres.yair.renteria.murillo@gmail.com'];
    }
    function autorizado() {
      return esRectora() || (conSesion()
        && exists(/databases/$(database)/documents/config/global)
        && correo() in get(/databases/$(database)/documents/config/global).data.docentes);
    }

    // Datos de la institución, año, fechas y lista de docentes autorizados
    match /config/global {
      allow read: if conSesion();
      allow write: if esRectora();
    }

    // Datos de cada docente: solo el dueño escribe; el dueño y la rectora leen
    match /usuarios/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esRectora());
      allow write: if conSesion() && request.auth.uid == uid && autorizado();

      match /{sub=**} {
        allow read: if conSesion() && (request.auth.uid == uid || esRectora());
        allow write: if conSesion() && request.auth.uid == uid && autorizado();
      }
    }
  }
}
